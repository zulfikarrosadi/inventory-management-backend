meta {
  name: Refresh Token
  type: http
  seq: 3
}

get {
  url: {{base_url}}/refresh
  body: none
  auth: inherit
}

script:post-response {
  if(res.getStatus() === 200) {
    const body = res.getBody()
    const userId = body.data.user.id
    const username = body.data.user.username
    
    bru.setEnvVar("current_username", username)
    bru.setEnvVar("current_user_id", userId)
  }
}

tests {
  test("expect status code to 200", function() {
    expect(res.getStatus()).to.equal(200);
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
