meta {
  name: Warehouses
  type: http
  seq: 2
}

get {
  url: {{base_url}}/warehouses
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
      const result = res.getBody();
      const warehouses = result.data.warehouses
      bru.setEnvVar("warehouse_id", warehouses[0].id)
      bru.setEnvVar('warehouse_id_to_delete', warehouses[warehouses.length - 1].id)
  }
  
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
